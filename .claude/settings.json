{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh issue:*)",
      "Bash(gh auth:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git config user.name)",
      "Bash(git clone:*)",
      "Bash(git sparse-checkout:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(grep:*)",
      "Bash(tee:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(cd:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(rm -i:*)",
      "Bash(mv -i:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(find:*)",
      "Bash(env)",
      "Bash(ls:*)",
      "Bash(ninja:*)",
      "Bash(br:*)",
      "Bash(xargs:*)",
      "Bash([ -f /.dockerenv ])",
      "Bash(pre-commit run:*)",
      "Bash(rocminfo:*)",
      "Bash(iree-compile:*)",
      "Bash(./scripts/git-in.sh:*)",
      "Bash(./build_tools/scripts/build.sh:*)",
      "Bash(./build_tools/scripts/test.sh:*)",
      "Bash(./build_tools/scripts/coverage.sh:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(./scripts/git-in.sh * push *)",
      "Bash(./scripts/git-in.sh * push)",
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- BEADS STATUS ---'; br list --status=in_progress 2>/dev/null; echo '--- READY BEADS ---'; br ready 2>/dev/null | head -20; echo '---'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "br sync --flush-only 2>/dev/null; IN_PROGRESS=$(br list --status=in_progress 2>/dev/null | grep -c '.'); if [ \"$IN_PROGRESS\" -gt 0 ]; then echo \"WARNING: $IN_PROGRESS beads still in_progress. Close or update them.\"; fi"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false
  }
}
