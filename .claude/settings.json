{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git config user.name)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(cd:*)",
      "Bash(curl:*)",
      "Bash(rm -i:*)",
      "Bash(mv -i:*)",
      "Bash(echo:*)",
      "Bash(env)",
      "Bash([ -f /.dockerenv ])",
      "Bash(pre-commit run:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  }
}
