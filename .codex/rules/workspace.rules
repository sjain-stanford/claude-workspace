# allow
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")
prefix_rule(pattern=["gh", "run", "list"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["gh", "workflow", "list"], decision="allow")
prefix_rule(pattern=["gh", "issue"], decision="allow")
prefix_rule(pattern=["gh", "auth"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "worktree"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "config", "user.name"], decision="allow")
prefix_rule(pattern=["git", "config", "user.email"], decision="allow")
prefix_rule(pattern=["git", "clone"], decision="allow")
prefix_rule(pattern=["git", "sparse-checkout"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "grep"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["tee"], decision="allow")
prefix_rule(pattern=["cmake"], decision="allow")
prefix_rule(pattern=["ctest"], decision="allow")
prefix_rule(pattern=["python3"], decision="allow")
prefix_rule(pattern=["rm", "-i"], decision="allow")
prefix_rule(pattern=["mv", "-i"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["nproc"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["env"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["ninja"], decision="allow")
prefix_rule(pattern=["br"], decision="allow")
prefix_rule(pattern=["xargs"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "[ -f /.dockerenv ] && echo \"In Docker\" || echo \"Not in Docker\""], decision="allow")
prefix_rule(pattern=["curl", "-sL", "https://iree.dev/pip-release-links.html"], decision="allow")
prefix_rule(pattern=["pre-commit", "run"], decision="allow")
prefix_rule(pattern=["rocminfo"], decision="allow")
prefix_rule(pattern=["iree-compile"], decision="allow")
prefix_rule(pattern=["./build_tools/scripts/build.sh"], decision="allow")
prefix_rule(pattern=["./build_tools/scripts/test.sh"], decision="allow")
prefix_rule(pattern=["./build_tools/scripts/coverage.sh"], decision="allow")

# forbidden
prefix_rule(pattern=["git", "push"], decision="forbidden")
