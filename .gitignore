# Ignore all sub-repositories in projects.
projects/*

# Ignore all internal EMU repositories.
projects-emu/*

# Ignore PR review contents.
reviews/*

# Ignore plan contents.
plans/*

# Ignore local caches, retaining the shared review configuration.
.cache/*
!.cache/peanut-review/
.cache/peanut-review/*
!.cache/peanut-review/.peanut-review.json

# Ignore machine-specific Claude settings.
.claude/settings.local.json

# Ignore optional local workspace context.
/LOCAL_CONTEXT.md

# Ignore beads local issue tracker.
.beads/

__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
