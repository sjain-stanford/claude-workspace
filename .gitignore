# Ignore all sub-repositories in projects/
projects/*
!projects/.gitkeep

# Ignore PR review contents but track the directory
reviews/*
!reviews/.gitkeep

# Ignore plan contents but track the directory
plans/*
!plans/.gitkeep

# Ignore IDE and docker cache directories
.cursor/
.cache/

# Ignore machine-specific Claude settings
.claude/settings.local.json

# Ignore beads local issue tracker
.beads/
