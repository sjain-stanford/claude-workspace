#!/usr/bin/env python3
"""Synchronize the filtered peanut-review history with agent-workspace."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "tools" / "peanut-review.upstream.json"
DEFAULT_SOURCE = ROOT / "projects" / "agent-workspace"


def run(
    args: list[str],
    *,
    cwd: Path = ROOT,
    capture: bool = False,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        cwd=cwd,
        check=True,
        text=True,
        capture_output=capture,
    )


def output(args: list[str], *, cwd: Path = ROOT) -> str:
    return run(args, cwd=cwd, capture=True).stdout.strip()


def load_manifest() -> dict:
    return json.loads(MANIFEST.read_text())


def resolve_source(raw: str | None, manifest: dict) -> str:
    if raw:
        candidate = Path(raw).expanduser()
        return str(candidate.resolve()) if candidate.exists() else raw
    if DEFAULT_SOURCE.is_dir():
        return str(DEFAULT_SOURCE)
    return str(manifest["repository"])


def source_revision(source: str, ref: str) -> str:
    source_path = Path(source)
    if not source_path.is_dir():
        raise ValueError("status requires a local --source checkout")
    return output(["git", "rev-parse", ref], cwd=source_path)


def require_ancestor(source: str, base: str, target: str) -> None:
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", base, target],
        cwd=source,
        check=False,
    )
    if result.returncode != 0:
        raise ValueError(
            f"recorded revision {base} is not an ancestor of {target}; "
            "inspect the upstream history rewrite before continuing"
        )


def filter_repo_binary() -> str:
    configured = os.environ.get("GIT_FILTER_REPO")
    candidates = [
        configured,
        shutil.which("git-filter-repo"),
        str(ROOT / ".cache" / "git-filter-repo-venv" / "bin" / "git-filter-repo"),
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return candidate
    raise ValueError(
        "git-filter-repo is required; install it or set GIT_FILTER_REPO"
    )


def require_clean_worktree() -> None:
    if output(["git", "status", "--porcelain"]):
        raise ValueError("pull requires a clean claude-workspace worktree")


def filtered_clone(source: str, revision: str, paths: list[str], destination: Path) -> str:
    run(["git", "clone", "--no-local", source, str(destination)])
    run(["git", "branch", "filtered", revision], cwd=destination)
    command = [filter_repo_binary(), "--force", "--refs", "filtered"]
    for path in paths:
        command.extend(["--path", path])
    run(command, cwd=destination)
    return output(["git", "rev-parse", "filtered"], cwd=destination)


def cmd_status(args: argparse.Namespace) -> int:
    manifest = load_manifest()
    source = resolve_source(args.source, manifest)
    target = source_revision(source, args.ref)
    require_ancestor(source, manifest["revision"], target)
    print(f"Source:   {source}")
    print(f"Imported: {manifest['revision']}")
    print(f"Target:   {target}")
    if target == manifest["revision"]:
        print("Status:   up to date")
        return 0
    print("Status:   update available")
    run(
        [
            "git",
            "diff",
            "--stat",
            manifest["revision"],
            target,
            "--",
            *manifest["paths"],
        ],
        cwd=Path(source),
    )
    return 0


def cmd_pull(args: argparse.Namespace) -> int:
    require_clean_worktree()
    manifest = load_manifest()
    source = resolve_source(args.source, manifest)
    source_path = Path(source)
    if source_path.is_dir():
        target = source_revision(source, args.ref)
        require_ancestor(source, manifest["revision"], target)
    else:
        target = args.ref

    cache_dir = ROOT / ".cache"
    cache_dir.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="peanut-review-filter-", dir=cache_dir) as tmp:
        clone = Path(tmp) / "agent-workspace"
        if source_path.is_dir():
            filtered_tip = filtered_clone(source, target, manifest["paths"], clone)
        else:
            run(["git", "clone", "--no-local", source, str(clone)])
            target = output(["git", "rev-parse", args.ref], cwd=clone)
            require_ancestor(str(clone), manifest["revision"], target)
            run(["git", "branch", "filtered", target], cwd=clone)
            command = [filter_repo_binary(), "--force", "--refs", "filtered"]
            for path in manifest["paths"]:
                command.extend(["--path", path])
            run(command, cwd=clone)
            filtered_tip = output(["git", "rev-parse", "filtered"], cwd=clone)

        if filtered_tip == manifest["filteredTip"]:
            print(f"Already up to date at {target}")
            return 0

        candidate_ref = "refs/remotes/peanut-review-upstream/candidate"
        run(["git", "fetch", str(clone), f"filtered:{candidate_ref}"])
        run(
            [
                "git",
                "merge",
                "--no-ff",
                "--no-commit",
                candidate_ref,
            ]
        )

        manifest["revision"] = target
        manifest["filteredTip"] = filtered_tip
        MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n")
        run(["git", "add", str(MANIFEST.relative_to(ROOT))])
        run(
            [
                "git",
                "commit",
                "-s",
                "-m",
                f"Update peanut-review from agent-workspace {target[:12]}",
                "-m",
                "Merge the deterministically filtered peanut-review paths and "
                "advance the recorded upstream provenance.",
            ]
        )
    return 0


def cmd_export(args: argparse.Namespace) -> int:
    manifest = load_manifest()
    command = [
        "git",
        "diff",
        "--binary",
        args.base,
        args.head,
        "--",
        *manifest["paths"],
    ]
    patch = run(command, capture=True).stdout
    if args.output == "-":
        sys.stdout.write(patch)
    else:
        destination = Path(args.output)
        destination.write_text(patch)
        print(f"Wrote {destination}")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Synchronize peanut-review with its filtered upstream history"
    )
    subparsers = result.add_subparsers(dest="command", required=True)

    status = subparsers.add_parser("status", help="compare the port with upstream")
    status.add_argument("--source", help="local agent-workspace checkout")
    status.add_argument("--ref", default="origin/main", help="upstream ref")
    status.set_defaults(func=cmd_status)

    pull = subparsers.add_parser("pull", help="filter and merge an upstream revision")
    pull.add_argument("--source", help="checkout or repository URL")
    pull.add_argument("--ref", default="origin/main", help="upstream ref")
    pull.set_defaults(func=cmd_pull)

    export = subparsers.add_parser("export", help="export downstream path changes")
    export.add_argument("--base", required=True, help="base revision")
    export.add_argument("--head", default="HEAD", help="head revision")
    export.add_argument("--output", required=True, help="patch file or '-' for stdout")
    export.set_defaults(func=cmd_export)
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
